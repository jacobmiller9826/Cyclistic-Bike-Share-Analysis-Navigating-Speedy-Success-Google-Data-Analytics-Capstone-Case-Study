SELECT
  member_casual,
  COUNT(ride_id) AS total_rides,
  -- Calculate percentage share of total rides
  ROUND(COUNT(ride_id) / SUM(COUNT(ride_id)) OVER() * 100, 2) AS percentage_of_total,
  -- Average trip time rounded to 2 decimals
  ROUND(AVG(ride_length_minutes), 2) AS avg_ride_length_minutes
FROM 
  `your_project.cyclistic.cleaned_year_trips`
GROUP BY 
  member_casual;
